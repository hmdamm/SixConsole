<Window
    x:Class="SixConsole.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SixConsole.App.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Six Console">
    <Grid RowDefinitions="Auto,*"
          Background="{ThemeResource AppWindowBackgroundBrush}">
        <controls:TitleBar x:Name="AppTitleBar" Grid.Row="0"
                           Background="{ThemeResource AppWindowBackgroundBrush}"
                           Title="Six Console"
                           Subtitle="mouse profile console">
            <controls:TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                    <Border CornerRadius="10" Padding="10,2"
                            Background="{ThemeResource ControlFillActiveBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse x:Name="PillOk" Fill="{ThemeResource SuccessBrush}" Visibility="Collapsed"/>
                                <Ellipse x:Name="PillMuted" Fill="{ThemeResource TextMutedBrush}"/>
                                <Ellipse x:Name="PillErr" Fill="{ThemeResource ErrorBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="StatusPillText" Text="INITIALIZING" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StopButton" Content="STOP" Style="{StaticResource StopButton}"
                            Click="Stop_Click" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Emergency stop: cancels all loops, releases the rapid-fire key and disables the profile"/>
                </StackPanel>
            </controls:TitleBar.RightHeader>
        </controls:TitleBar>
        <views:ShellView x:Name="Shell" Grid.Row="1"/>
    </Grid>
</Window>
