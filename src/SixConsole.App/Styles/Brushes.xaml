<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      All local UI colors use ONLY these tokens (windows-fluent-native + pro-utility-monochrome):
      - neutral layers + hairlines      (95% monochrome)
      - single action accent #60CDFF dark / #0078D4 light
      - meaning-carrier status colors   (success / warning / error)
      Local brushes must be referenced via ThemeDictionaries so Light/Dark/System all resolve.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#202020"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1D1D1D"/>
            <SolidColorBrush x:Key="ControlFillBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#323232"/>
            <SolidColorBrush x:Key="ControlFillActiveBrush" Color="#272727"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="#353535"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#202020"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#787878"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFB900"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4"/>
            <SolidColorBrush x:Key="SelectedRailBrush" Color="#60CDFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
            <SolidColorBrush x:Key="ControlFillBrush" Color="#FBFBFB"/>
            <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="ControlFillActiveBrush" Color="#EFEFEF"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5A5A"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#A8A8A8"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#13A10E"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#B25E00"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
            <SolidColorBrush x:Key="SelectedRailBrush" Color="#0078D4"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ControlFillBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ControlFillActiveBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="SelectedRailBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
