<UserControl
    x:Class="SixConsole.App.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SixConsole.App.ViewModels"
    xmlns:cnv="using:SixConsole.App.Helpers"
    xmlns:controls="using:SixConsole.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Roster + weapons -->
        <Border Style="{StaticResource ActionCard}" Margin="16,12,8,12" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    PlaceholderText="Search operators"
                    Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Height="30"
                    CornerRadius="4"/>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Attackers" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="AttackerRoster" ItemsSource="{x:Bind ViewModel.Attackers, Mode=OneWay}" Margin="-4,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperatorRow">
                                    <ToggleButton
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Click="Operator_Click"
                                        Tag="{x:Bind OperatorId}"
                                        AutomationProperties.Name="{x:Bind ToolTip_}"
                                        Style="{StaticResource RosterButton}"
                                        Margin="0,0,4,4"
                                        ToolTipService.ToolTip="{x:Bind ToolTip_}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BaseText}"/>
                                            <TextBlock Text="{x:Bind WeaponCountText}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Defenders" Style="{StaticResource SectionHeader}" Margin="0,12,0,0"/>
                        <ItemsControl x:Name="DefenderRoster" ItemsSource="{x:Bind ViewModel.Defenders, Mode=OneWay}" Margin="-4,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperatorRow">
                                    <ToggleButton
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Click="Operator_Click"
                                        Tag="{x:Bind OperatorId}"
                                        AutomationProperties.Name="{x:Bind ToolTip_}"
                                        Style="{StaticResource RosterButton}"
                                        Margin="0,0,4,4"
                                        ToolTipService.ToolTip="{x:Bind ToolTip_}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BaseText}"/>
                                            <TextBlock Text="{x:Bind WeaponCountText}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Loadout" Style="{StaticResource SectionHeader}" Margin="0,16,0,0"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedOperatorName, Mode=OneWay}"
                                   Style="{StaticResource SubTitleText}" Margin="0,2,0,6"/>
                        <ListView x:Name="WeaponList"
                                  ItemsSource="{x:Bind ViewModel.Weapons, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedWeaponIndex, Mode=OneWay}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="Weapon_Click"
                                  SelectionChanged="Weapon_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeaponRow">
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind OneBased}" Style="{StaticResource NumberText}"
                                                   Foreground="{ThemeResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Weapon.Name}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource ModeChip}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{x:Bind Mode}" Style="{StaticResource MutedText}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{x:Bind PullText}" Style="{StaticResource NumberText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Summary panel -->
        <Border Style="{StaticResource ActionCard}" Margin="8,12,16,12" Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource SectionHeader}"/>
                    <ToggleSwitch x:Name="EnabledToggle"
                                  Header="Enabled"
                                  IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                                  Toggled="EnabledToggle_Toggled"
                                  Margin="0,8,0,0"/>

                    <Border Style="{StaticResource Hairline}" Margin="0,10,0,10"/>

                    <TextBlock Text="Selection" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedOperatorName, Mode=OneWay}"
                               Style="{StaticResource SubTitleText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                               Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Hairline}" Margin="0,10,0,10"/>

                    <TextBlock Text="Input backend" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{x:Bind ViewModel.EngineStatusText, Mode=OneWay}"
                               Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{x:Bind ViewModel.LastError, Mode=OneWay}"
                               Style="{StaticResource BaseText}"
                               Foreground="{ThemeResource ErrorBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind cnv:Bindings.BoolToVis(ViewModel.LastErrorVisible), Mode=OneWay}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

