<UserControl
    x:Class="SixConsole.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cnv="using:SixConsole.App.Helpers">

    <ScrollViewer Padding="16,12,16,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save" Style="{StaticResource ToolButton}" Click="Save_Click"/>
                <Button Content="Revert" Style="{StaticResource ToolButton}" Click="Revert_Click"/>
                <Button Content="Restore source defaults…" Style="{StaticResource ToolButton}" Click="Defaults_Click"/>
                <TextBlock Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                       Style="{StaticResource BodyText}"
                       Foreground="{ThemeResource ErrorBrush}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind cnv:Bindings.NullOrEmptyToCollapsed(ViewModel.ValidationSummary), Mode=OneWay}"/>

            <!-- Recoil & movement -->
            <Border Style="{StaticResource ActionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Recoil &amp; movement" Style="{StaticResource SubTitleText}"/>
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Recoil sensitivity ×" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.RecoilMultiplier, Mode=TwoWay}" AutomationProperties.Name="Recoil sensitivity value" Minimum="0.1" Maximum="5" SmallChange="0.05" LargeChange="0.5"
                                   ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Column="2" Text="×" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Pull is weapon.pull × this value (rounded like the script)." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="Vertical variance ±" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="1" Grid.Column="1" Value="{x:Bind ViewModel.VertVariance, Mode=TwoWay}" AutomationProperties.Name="Vertical variance value" Minimum="0" Maximum="100" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Random extra vertical movement per tick." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Text="Horizontal jitter ±" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="2" Grid.Column="1" Value="{x:Bind ViewModel.HorizJitter, Mode=TwoWay}" AutomationProperties.Name="Horizontal jitter value" Minimum="0" Maximum="100" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="px" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Random left/right drift per tick." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Full-auto delay -->
            <Border Style="{StaticResource ActionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Full-auto recoil delay" Style="{StaticResource SubTitleText}"/>
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Delay minimum" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.DelayMin, Mode=TwoWay}" AutomationProperties.Name="Delay minimum value" Minimum="0" Maximum="5000" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Minimum wait between movement ticks." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="Delay maximum" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="1" Grid.Column="1" Value="{x:Bind ViewModel.DelayMax, Mode=TwoWay}" AutomationProperties.Name="Delay maximum value" Minimum="0" Maximum="5000" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Maximum wait between movement ticks." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rapid fire -->
            <Border Style="{StaticResource ActionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Rapid fire" Style="{StaticResource SubTitleText}"/>
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Rapid-fire key" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RfKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="One character; the app presses/releases this key in bursts." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="Hold minimum" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="1" Grid.Column="1" Value="{x:Bind ViewModel.HoldMin, Mode=TwoWay}" AutomationProperties.Name="Hold minimum value" Minimum="0" Maximum="5000" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Shortest key-down burst." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Text="Hold maximum" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="2" Grid.Column="1" Value="{x:Bind ViewModel.HoldMax, Mode=TwoWay}" AutomationProperties.Name="Hold maximum value" Minimum="0" Maximum="5000" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Longest key-down burst." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Text="Gap minimum" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="3" Grid.Column="1" Value="{x:Bind ViewModel.GapMin, Mode=TwoWay}" AutomationProperties.Name="Gap minimum value" Minimum="0" Maximum="5000" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Shortest pause between bursts." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Text="Gap maximum" Style="{StaticResource BaseText}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Row="4" Grid.Column="1" Value="{x:Bind ViewModel.GapMax, Mode=TwoWay}" AutomationProperties.Name="Gap maximum value" Minimum="0" Maximum="5000" SmallChange="1" ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Inline" Height="30" CornerRadius="4"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Longest pause between bursts." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Theme -->
            <Border Style="{StaticResource ActionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Theme" Style="{StaticResource SubTitleText}"/>
                    <RadioButtons x:Name="ThemePicker" SelectionChanged="Theme_SelectionChanged">
                        <RadioButton Content="System (follows Windows)" Tag="System"/>
                        <RadioButton Content="Light" Tag="Light"/>
                        <RadioButton Content="Dark" Tag="Dark"/>
                    </RadioButtons>
                    <TextBlock Text="Changes apply immediately and are remembered." Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Style="{StaticResource ActionCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Where is my data?" Style="{StaticResource SubTitleText}"/>
                    <TextBlock Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}" Style="{StaticResource SecondaryText}" IsTextSelectionEnabled="True"/>
                    <TextBlock Text="Settings persist in a plain JSON file there; the app writes log.txt alongside it. Import/export of profiles is not provided in this version: the catalogue is compiled from the original script and cannot be edited." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>



