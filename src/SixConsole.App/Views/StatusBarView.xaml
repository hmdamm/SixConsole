<UserControl
    x:Class="SixConsole.App.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="0,1,0,0">
        <Grid Margin="12,0,12,0" VerticalAlignment="Center" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse x:Name="DotSuccess" Fill="{ThemeResource SuccessBrush}" Visibility="Collapsed"/>
                <Ellipse x:Name="DotMuted" Fill="{ThemeResource TextMutedBrush}"/>
                <Ellipse x:Name="DotError" Fill="{ThemeResource ErrorBrush}" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="HealthText" Grid.Column="1"
                       Text="starting…" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CapsText" Grid.Column="2" Text="caps off"
                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectionText" Grid.Column="3" Text=""
                       Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ErrorText" Grid.Column="4" Text=""
                       Style="{StaticResource MutedText}"
                       Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
